#!/usr/bin/env bash
# Launch the sandboxed desktop app; retain the Chrome alternative.
set -euo pipefail
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
APP_DIR="$SCRIPT_DIR/current"
[ ! -f "$SCRIPT_DIR/main.cjs" ] || APP_DIR="$SCRIPT_DIR"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/openclaw-hub-desktop"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/openclaw-hub-desktop"
if [ -r "$CONFIG_DIR/config.env" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_DIR/config.env"
fi
export HUB_URL="${HUB_URL:-http://127.0.0.1:18900/}"
if [ "${1:-}" = "--version" ]; then cat "$APP_DIR/VERSION"; exit 0; fi
if [ "${1:-}" = "--browser" ]; then shift; exec "$SCRIPT_DIR/openclaw-hub-browser" "$@"; fi
ELECTRON="$APP_DIR/node_modules/electron/dist/electron"
if [ ! -x "$ELECTRON" ]; then
  command -v notify-send >/dev/null 2>&1 && notify-send Hub 'Falta el motor de escritorio. Vuelve a ejecutar el instalador.' || true
  printf 'Hub: falta el motor de escritorio; ejecuta desktop/install.sh.\n' >&2
  exit 1
fi
# The installer configures a trusted sandbox helper where needed. Chromium's
# sandbox stays enabled; no AppArmor or user-namespace settings are changed.
mkdir -p -m 700 "$STATE_DIR"
# Select Ozone before Electron starts; setting it from main.cjs is too late.
# Use the validated X11/XWayland file-drop path when a display is available.
BACKEND_ARGS=()
if [ -n "${DISPLAY:-}" ]; then
  HAS_BACKEND=0
  for ARG in "$@"; do
    case "$ARG" in --ozone-platform|--ozone-platform=*) HAS_BACKEND=1 ;; esac
  done
  if [ "$HAS_BACKEND" = 0 ]; then BACKEND_ARGS=(--ozone-platform=x11); fi
fi
exec "$ELECTRON" "$APP_DIR" "${BACKEND_ARGS[@]}" "$@" >>"$STATE_DIR/native.log" 2>&1
